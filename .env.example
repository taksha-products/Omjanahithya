# Site Configuration
SITE_URL=https://omjanahithaya.com

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Hero drone video CDN URL (optional — defaults to /videos/hero-drone.mp4)
# Set in production after uploading to Cloudflare R2 or Vercel Blob
# NEXT_PUBLIC_HERO_VIDEO_URL=https://your-cdn.example.com/hero-drone.mp4

# Formspree form ID (optional — for admission/contact forms)
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_id

# Google Search Console - Add verification meta tag in layout if needed
# NEXT_PUBLIC_GSC_VERIFICATION=your-verification-code
